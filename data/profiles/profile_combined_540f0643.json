    "transformation_recommendations": {
      "sales_data.transaction_id": "Create a derived column 'transaction_type' (e.g., 'sale' or 'return') based on the prefix and normalize the ID format.",
      "sales_data.transaction_date": "Parse dates using multiple patterns and store them in a standard ISO 8601 format (YYYY-MM-DD).",
      "sales_data.store_id": "Impute missing store_id values if possible (e.g., using most frequent store per region) or flag rows for review.",
      "sales_data.quantity": "Separate returns from sales by using the derived 'transaction_type'; ensure quantity is non\u2011negative for sales and treat negative values as absolute quantities for returns.",
      "sales_data.total_amount": "Similarly, adjust total_amount to be positive for sales and negative for returns, or store a separate 'net_amount' column.",
